# Runtime
NODE_ENV=development
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3000
WEB_SIMULATOR_PORT=5174
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000

# Attack Adapter & Hardware BFF & Python Runtime
PYTHON_RUNTIME_URL=http://localhost:5002
VITE_HARDWARE_BFF_URL=http://localhost:5001

# Auth
JWT_ACCESS_SECRET=replace_with_very_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_very_long_random_refresh_secret
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# Device/simulator API keys
DEVICE_API_KEY=replace_with_device_ingest_key
SIMULATOR_API_KEY=replace_with_simulator_key
ATTACK_SIMULATOR_API_KEY=replace_with_attack_simulator_key
VITE_SIMULATOR_API_KEY=replace_with_simulator_key
VITE_ATTACK_SIMULATOR_API_KEY=replace_with_attack_simulator_key
HARDWARE_RUNTIME_SERVICE_KEY=replace_with_hardware_runtime_key_32bytes
ATTACK_RUNTIME_SERVICE_KEY=replace_with_attack_runtime_key_32bytes

# Web attacker is a demo-only local surface, not a database role.
# Do not expose the web simulator publicly in production.

# Encryption
AES_SECRET_KEY=replace_with_32_byte_secret
AES_IV=replace_with_16_byte_iv_only_for_legacy_cbc

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_strong_password
MONGO_DB=ics_guard
MONGO_PORT=27017
MONGO_URI=mongodb://admin:replace_with_strong_password@localhost:27017/ics_guard?authSource=admin

# Redis
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=rediss://:replace_with_strong_redis_password@redis:6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=ics_guard
RABBITMQ_DEFAULT_PASS=replace_with_strong_rabbitmq_password
RABBITMQ_URL=amqp://ics_guard:replace_with_strong_rabbitmq_password@rabbitmq:5672/

# InfluxDB
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=replace_with_strong_influx_password
INFLUXDB_DB=ics_telemetry
INFLUXDB_URL=http://influxdb:8086

# MQTT
MQTT_URL=mqtts://mosquitto:8883
MQTT_PORT=1883
MQTT_TLS_PORT=8883
REQUIRE_TLS=true
ALLOW_INSECURE_TLS=false

# Resettable local/demo seed only. Replace or remove for any real deployment.
DEMO_USER_PASSWORD=Demo@12345

# AI
AI_ENGINE_URL=https://ai-engine:5000
AI_RELOAD=false
GEMINI_API_KEY=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434
NVD_API_KEY=

# Notification
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set false for an offline demo to prevent polling/network errors.
TELEGRAM_POLLING_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
